{
  "name": "wp-escouade",
  "version": "1.0.0",
  "description": "Wordpress website for Escouade",
  "homepage": "https://github.com/e-rocky/wp-escouade#readme",
  "bugs": {
    "url": "https://github.com/e-rocky/wp-escouade/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-rocky/wp-escouade.git"
  },
  "license": "ISC",
  "author": "Rocky",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "setup": "npm run install:all && npm run composer:all && npm run build:all",
    "composer": "npm run composer:all",
    "composer:all": "npm run composer:root && npm run composer:aura",
    "composer:root": "composer install",
    "composer:aura": "composer install --working-dir=web/app/themes/aura",
    "install": "npm run install:all",
    "install:all": "npm run install:aura && npm run install:blocks",
    "install:aura": "npm --prefix web/app/themes/aura install",
    "install:blocks": "npm --prefix web/app/themes/aura/app/blocks install",
    "build": "npm run build:all",
    "build:all": "npm run build:aura && npm run build:blocks",
    "build:aura": "npm --prefix web/app/themes/aura run build",
    "build:blocks": "npm --prefix web/app/themes/aura/app/blocks run build",
    "watch:aura": "npm --prefix web/app/themes/aura run watch",
    "start:aura": "npm --prefix web/app/themes/aura run dev",
    "start:blocks": "npm --prefix web/app/themes/aura/app/blocks run start",
    "zip:aura": "rm -rf aura.zip && npm run build:all && npm run composer:aura && cd web/app/themes && 7z a -tzip ../../../aura.zip aura -x!aura/node_modules -x!aura/resources/images -x!aura/src -x!aura/app/blocks/node_modules -x!.git -x!src -x!scripts -x!*.html && cd ../../..",
    "bump:style:patch": "node web/app/themes/aura/src/js/increment-style-version.js patch",
    "bump:style:minor": "node web/app/themes/aura/src/js/increment-style-version.js minor",
    "bump:style:major": "node web/app/themes/aura/src/js/increment-style-version.js major",
    "git:patch": "npm run bump:style:patch && git commit -a --amend",
    "git:minor": "npm run bump:style:minor && git commit -a --amend",
    "git:major": "npm run bump:style:major && git commit -a --amend"
  }
}
