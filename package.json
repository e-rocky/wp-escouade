{
  "name": "wp-escouade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "icons": "node ./scripts/build-icons.mjs",
    "sprite": "svg-sprite --symbol --symbol-dest public/img/design --symbol-sprite sprite.svg --symbol-render-scss --symbol-prefix \".icon.icon-%s\" --symbol-dimensions \"\" --shape-id-generator %s public/img/design/!(sprite).svg"
  },
  "devDependencies": {
    "@types/uikit": "^3.23.0",
    "cssnano": "^7.0.7",
    "postcss": "^8.4.47",
    "sass-embedded": "^1.79.5",
    "svg-sprite": "^2.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "svgtofont": "^6.5.1",
    "uikit": "^3.25.6",
    "unocss": "^66.6.0"
  }
}
