{
  "name": "wp-escouade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && cross-env VITE_ASSET_BASE=/wp-content/themes/aura/public/build/ vite build",
    "watch": "cross-env VITE_ASSET_BASE=/wp-content/themes/aura/public/build/ vite build --watch",
    "build:bedrock": "tsc && vite build",
    "preview": "vite preview",
    "icons": "node ./scripts/build-icons.mjs",
    "sprite": "svg-sprite --symbol --symbol-dest public/img/design --symbol-sprite sprite.svg --symbol-render-scss --symbol-prefix \".icon.icon-%s\" --symbol-dimensions \"\" --shape-id-generator %s public/img/design/!(sprite).svg",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --include=\"theme.json,patterns,app,resources\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/sage.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "devDependencies": {
    "@roots/vite-plugin": "^1.0.2",
    "@tailwindcss/vite": "^4.0.9",
    "@types/autosize": "^4.0.3",
    "@types/react-dom": "^19.2.3",
    "@types/uikit": "^3.23.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^10.1.0",
    "cssnano": "^7.0.7",
    "laravel-vite-plugin": "^2.1.0",
    "postcss": "^8.4.47",
    "sass-embedded": "^1.79.5",
    "svg-sprite": "^2.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "autosize": "^6.0.1",
    "intl-tel-input": "^26.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-select": "^5.10.2",
    "replace-in-file": "^8.4.0",
    "smdm-slide-menu": "^2.2.1",
    "svgtofont": "^6.5.1",
    "uikit": "3.23.13",
    "unocss": "^66.6.0",
    "uppy": "^5.2.3"
  }
}
