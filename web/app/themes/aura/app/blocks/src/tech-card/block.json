{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/tech-card",
  "version": "0.1.0",
  "title": "Tech Card",
  "category": "widgets",
  "icon": "image-filter",
  "description": "A technology category slide with a grid of tech logos and names.",
  "example": {},
  "supports": {
    "html": false
  },
  "parent": ["create-block/tech-block"],
  "attributes": {
    "categoryLabel": {
      "type": "string",
      "default": "Backend"
    },
    "subtitleText": {
      "type": "string",
      "default": "au coeur de nos réalisations"
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    }
  },
  "textdomain": "tech-card",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
