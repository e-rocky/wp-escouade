{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/content-card",
  "version": "0.1.0",
  "title": "Content Card",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "example": {},
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "headingText": {
      "type": "string",
      "default": "Qui sommes-nous"
    },
    "bodyText": {
      "type": "string",
      "default": "<p>Chez Escouade, nous croyons que la réussite d'un projet repose avant tout sur les personnes.</p>"
    },
    "image": {
      "type": "object",
      "default": {
        "url": "https://picsum.photos/id/206/576/414.jpg",
        "alt": "",
        "id": null
      }
    },
    "button": {
      "type": "object",
      "default": {
        "text": "Découvrir l'Escouade",
        "url": "#",
        "openInNewTab": false
      }
    },
    "transparentBackground": {
      "type": "boolean",
      "default": true
    },
    "imgPosition": {
      "type": "number",
      "default": 0
    },
    "overline": {
      "type": "object",
      "default": {
        "show": false,
        "text": "Un cadre de travail respectueux"
      }
    },
    "cardStyle": {
      "type": "number",
      "default": 1
    }
  },
  "textdomain": "content-card",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
