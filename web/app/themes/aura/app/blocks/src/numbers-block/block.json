{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/numbers-block",
  "version": "0.1.0",
  "title": "Numbers Block",
  "category": "widgets",
  "description": "Bloc chiffres clés avec grille de statistiques.",
  "example": {},
  "supports": {
    "html": false
  },
  "allowedBlocks": ["create-block/numbers-item"],
  "attributes": {
    "background": {
      "type": "string",
      "default": "bgi--5"
    },
    "headingText": {
      "type": "string",
      "default": "Quelques chiffres clés"
    },
    "headingSmall": {
      "type": "string",
      "default": "qui nous définissent"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
